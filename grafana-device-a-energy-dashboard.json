      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "afqsxbqedxlhcd"
                    },
                    "group": "influxdb",
                    "kind": "DataQuery",
                    "spec": {
                      "query": "from(bucket: \"sensor_futu\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\")\n  |> filter(fn: (r) => r[\"sn\"] == \"${sn}\")\n  |> filter(fn: (r) => contains(value: r[\"_field\"], set: [\"voltage\", \"current\", \"activePower\", \"powerFactor\", \"frequency\", \"totalActiveEnergy\", \"EnergySession\", \"CountSession\", \"reactivePower\", \"apparentPower\", \"rssi\"]))\n  |> group(columns: [\"_field\"])\n  |> last()\n  |> map(fn: (r) => ({ r with _field:\n      if r._field == \"voltage\" then \"Voltage (V)\"\n      else if r._field == \"current\" then \"Current (A)\"\n      else if r._field == \"activePower\" then \"Active Power (kW)\"\n      else if r._field == \"powerFactor\" then \"Power Factor\"\n      else if r._field == \"frequency\" then \"Frequency (Hz)\"\n      else if r._field == \"totalActiveEnergy\" then \"Total Energy (kWh)\"\n      else if r._field == \"EnergySession\" then \"Energy Session (kWh)\"\n      else if r._field == \"CountSession\" then \"Count Session\"\n      else if r._field == \"reactivePower\" then \"Reactive Power (kvar)\"\n      else if r._field == \"apparentPower\" then \"Apparent Power (kVA)\"\n      else \"RSSI (dBm)\"\n  }))\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
