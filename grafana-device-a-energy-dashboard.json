                      "query": "from(bucket: \"sensor_futu\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\")\n  |> filter(fn: (r) => r[\"sn\"] == \"${sn}\")\n  |> filter(fn: (r) => contains(value: r[\"_field\"], set: [\"voltage\", \"current\", \"activePower\", \"powerFactor\", \"frequency\"]))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({ r with _field:\n      if r._field == \"voltage\" then \"Voltage (V)\"\n      else if r._field == \"current\" then \"Current (A)\"\n      else if r._field == \"activePower\" then \"Active Power (kW)\"\n      else if r._field == \"powerFactor\" then \"Power Factor\"\n      else \"Frequency (Hz)\"\n  }))\n  |> group(columns: [\"_field\"])\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
